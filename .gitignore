# Shared .gitignore for every project in this workspace.
# The same file is the global core.excludesfile, so a project with a missing
# or broken .gitignore is still protected. A Repo merges these rules into its own.

# --- 1. Secrets and credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!*.pub
.ssh/
.gnupg/
credentials*.json
client_secret*.json
service-account*.json
*-service-account.json
token.json
token.pickle
.netrc
.npmrc
.pypirc
.aws/
.docker/config.json
*.secret
*.secrets
secrets/

# --- 2. Hidden-leak files: browser exports, logs, local DBs, local settings ---
*.har
cookies.txt
*.cookies
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.local.*
*.local
.claude/settings.local.json

# --- 3. Caches and environments ---
.venv/
venv/
.conda/
node_modules/
.pnpm-store/
.yarn/cache/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/
.cache/
.parcel-cache/
.next/
.turbo/
dist/
build/
*.egg-info/
.tox/
coverage/
.coverage
*.safetensors
*.ckpt
*.gguf
*.onnx
.models/
*.pt
*.pth
.DS_Store
Thumbs.db

# --- 4. Video, audio and _tmp/ ---
_tmp/
*.mp4
*.mov
*.m4v
*.mkv
*.avi
*.webm
*.wmv
*.flv
*.prproj
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aiff
*.aif

# --- Repo's own rules (kept as they were; they come last, so their negations win) ---
__pycache__/
*.pyc
# generated: demo data and outputs, README video outputs
skills/in-progress/animate/examples/skcm-demo/data/
skills/in-progress/animate/examples/skcm-demo/runs/*/out/*
!skills/in-progress/animate/examples/skcm-demo/runs/*/out/report.md
docs/media/*/out/
